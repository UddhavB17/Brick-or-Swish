# Client-side Flagsmith environment key (safe for browsers).
# Get it from Flagsmith → Environment → Settings → Environment Key.
VITE_FLAGSMITH_ENVIRONMENT_KEY=

# Optional: override Flagsmith API (self-hosted only).
# VITE_FLAGSMITH_API=https://flagsmith.example.com/api/v1/

# Optional: override events ingestion URL (self-hosted only).
# VITE_FLAGSMITH_EVENTS_API=https://events.flagsmith.example.com/

# Optional: force a miss_feedback variant locally for UI QA (control | near_miss).
# Leave empty in production so Flagsmith decides.
# VITE_FORCE_MISS_FEEDBACK=

# --- scripts/simulate-traffic.mjs only (SIMULATED traffic; never commit real keys) ---
# Client-side key of a SEPARATE demo environment. The script refuses to reuse the game's key.
# FLAGSMITH_ENVIRONMENT_KEY=
# FLAGSMITH_API=https://edge.api.flagsmith.com/api/v1/
# FLAGSMITH_EVENTS_API=
# Number of simulated players.
# SIM_SESSIONS=400
# Absolute lift in replay probability for near_miss (0.10 = +10 pp). Ignored for the A/A flag.
# SIM_NEAR_MISS_LIFT=0.10
